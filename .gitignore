# ==============================================================================
# ASTRA HEALTH - .gitignore
# NASA Space Apps Challenge - Astronaut Health Monitoring Platform
# ==============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build Outputs & Bundles
dist/
dist-ssr/
build/
coverage/
*.tsbuildinfo

# Environment Variables & Sensitive Credentials
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env.*
*.pem
*.key
credentials.json
secrets.json

# Allow .env.example with placeholder templates
!.env.example
!**/.env.example

# Python Backend & Virtual Environments
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Machine Learning Datasets & Model Artifacts (Raw datasets excluded)
ml/datasets/*
!ml/datasets/.gitkeep

# Research Datasets Raw Downloads (Processed JSON caches preserved)
data/research/bidmc/
data/research/osd_575/
data/research/fitbit/
data/research/autonomic_aging/

# Exclude arbitrary model binaries by default, except our verified lightweight artifacts
ml/saved_models/*
!ml/saved_models/.gitkeep
!ml/saved_models/feature_config.json
!ml/saved_models/isolation_forest_model.joblib
!ml/saved_models/preprocessor_scaler.joblib

*.joblib
*.pkl
!ml/saved_models/*.joblib

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Cache & Temporary Files
*.tmp
*.temp
.cache/
.parcel-cache/
.eslintcache

# Editor & IDE Settings
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
