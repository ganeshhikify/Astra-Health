# ==============================================================================
# ASTRA HEALTH - .gitignore
# NASA Space Apps Challenge - Astronaut Health Monitoring Platform
# ==============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build Outputs & Bundles
dist/
dist-ssr/
build/
coverage/
*.tsbuildinfo

# Environment Variables & Sensitive Credentials
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
credentials.json
secrets.json

# Allow .env.example with placeholder templates
!.env.example

# Python Backend & Virtual Environments (Future development)
venv/
.venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Cache & Temporary Files
*.tmp
*.temp
.cache/
.parcel-cache/
.eslintcache

# Editor & IDE Settings
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
