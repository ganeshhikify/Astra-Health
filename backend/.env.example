# ==============================================================================
# ASTRA HEALTH - Backend Environment Configuration Template
# NASA Space Apps Challenge - Astronaut Health Monitoring Platform
# ==============================================================================
# SECURITY NOTICE:
# - Copy this file to .env for local development.
# - In production (e.g. Render, Railway), configure these via platform environment settings.
# - NEVER commit files containing real passwords, tokens, or connection strings to Git.
# ==============================================================================

# Application Runtime Configuration
PROJECT_NAME="ASTRA HEALTH API"
VERSION="0.1.0"
ENVIRONMENT="development"              # Set to "production" in deployed cloud environments
DEBUG=True                             # Set to False in production
API_V1_STR="/api/v1"

# ASGI Server Settings
HOST="127.0.0.1"                       # Set to "0.0.0.0" in Docker/Cloud containers
PORT=8000                              # Or read from platform $PORT

# Allowed CORS Origins (Comma-separated URLs for the React frontend)
# Local: http://localhost:3000,http://127.0.0.1:3000
# Production: https://your-astra-frontend.vercel.app
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# PostgreSQL Database Configuration
# Format: postgresql+psycopg://username:password@hostname:port/database_name
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_secure_password_here"
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="astra_health_demo"

# Direct Database URL (Recommended for cloud hosting e.g., Supabase, Neon, Render PostgreSQL)
# When set, DATABASE_URL overrides individual POSTGRES_* parameters above.
DATABASE_URL="postgresql+psycopg://postgres:your_secure_password_here@localhost:5432/astra_health_demo"

# Database Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=10

# Public Submission Demo Protection & Access Control
DEMO_READ_ONLY_MODE=true               # Blocks destructive DELETE requests during public review
DEMO_AUTH_ENABLED=false                # Set to true to require HTTP Basic Authentication
DEMO_AUTH_USER="astronaut"             # Username for demo deck access
DEMO_AUTH_PASSWORD="your_demo_password_here"  # Password for demo access (if enabled)
