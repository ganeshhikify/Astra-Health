# ==============================================================================
# ASTRA HEALTH - Backend Environment Configuration Template
# NASA Space Apps Challenge - Astronaut Health Monitoring Platform
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env:
#    cp .env.example .env   (or 'Copy-Item .env.example .env' in PowerShell)
# 2. Update the values below to match your local PostgreSQL configuration.
# 3. Never commit your actual .env file with sensitive credentials to Git.
# ==============================================================================

# Application Metadata
PROJECT_NAME="ASTRA HEALTH API"
VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# ASGI Server Settings
HOST="127.0.0.1"
PORT=8000

# Allowed CORS Origins (Comma-separated URLs for the React frontend)
BACKEND_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.67:3000"

# PostgreSQL Database Configuration
# Format: postgresql+psycopg://username:password@hostname:port/database_name
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_secure_password_here"
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="astra_health"

# Full Direct Database URL (Optional: Overrides individual variables if provided)
DATABASE_URL="postgresql+psycopg://postgres:your_secure_password_here@localhost:5432/astra_health"

# Database Connection Pool Settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=10
